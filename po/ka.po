# (auto-translated)
#: ../hacks/config/tronbit.xml.h:12
msgid ""
"\n"
"The character \"Bit\" from the film, \"Tron\".\n"
"\n"
"The \"yes\" state is a tetrahedron; the \"no\" state is the second\n"
"stellation of an icosahedron; and the idle state oscillates between\n"
