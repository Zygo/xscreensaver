# (auto-translated)
#: ../hacks/config/munch.xml.h:17
msgid ""
"\n"
"        DATAI 2\n"
"        ADDB 1,2\n"
"        ROTC 2,-22\n"
"        XOR 1,2\n"
"        JRST .-4\n"
"\n"
